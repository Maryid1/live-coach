*.key
*.p12
*.pfx
*.tar.gz
*.tgz
*.bak
*.local-backup
live-coach-backup*/

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store
/data/
/selfhost/data/
live-coach-scripts-*.json
